generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id             String          @id @default(uuid())
  name           String
  slug           String          @unique
  createdAt      DateTime        @default(now())
  activityLogs   ActivityLog[]
  decisions      DecisionLog[]
  invitations    Invitation[]
  issues         Issue[]
  memberships    Membership[]
  projects       Project[]
  notifications  Notification[]
  meetings       Meeting[]
  pullRequests   PullRequest[]
  deployments    Deployment[]
  buildPipelines BuildPipeline[]
  buildRuns      BuildRun[]
  gitCommits     GitCommit[]
  sprints        Sprint[]
}

model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  passwordHash          String
  name                  String
  emailVerified         Boolean               @default(false)
  emailVerifiedAt       DateTime?
  createdAt             DateTime              @default(now())
  emailVerificationTokens EmailVerificationToken[]
  activityLogs          ActivityLog[]
  comments              Comment[]
  decisions             DecisionLog[]
  sentInvitations       Invitation[]          @relation("InvitationsSent")
  assignedIssues        Issue[]               @relation("IssueAssignee")
  createdIssues         Issue[]               @relation("IssueCreator")
  memberships           Membership[]
  passwordResetTokens   PasswordResetToken[]
  refreshTokens         RefreshToken[]
  notificationsReceived Notification[]        @relation("NotificationRecipient")
  notificationsCaused   Notification[]        @relation("NotificationActor")
  notificationPreferences NotificationPreference[]
  recentlyViewedIssues  RecentlyViewedIssue[]
  createdMeetings       Meeting[]             @relation("MeetingCreator")
  meetingAttendances    MeetingAttendee[]     @relation("MeetingAttendance")
  authoredPullRequests  PullRequest[]         @relation("PullRequestAuthor")
  aiSummaryCaches       AISummaryCache[]
  prReviews             PullRequestReviewer[] @relation("PullRequestReviewerUser")
  triggeredDeployments  Deployment[]          @relation("DeploymentTriggeredBy")
  rolledBackDeployments Deployment[]          @relation("DeploymentRolledBackBy")
  triggeredBuildRuns    BuildRun[]            @relation("BuildRunTriggeredBy")
  createdBuildPipelines BuildPipeline[]
  createdSprints        Sprint[]

  // --- Coding Streak feature (additive) ---
  longestStreakDays      Int                @default(0)
  streakFreezesAvailable Int                @default(2)
  lastFreezeRefillAt     DateTime           @default(now())
  weeklyCommitGoal       Int                @default(20)
  weeklyIssueGoal        Int                @default(5)
  codingWebhookToken     String             @unique @default(uuid())
  gitCommits             GitCommit[]
  codingAchievements     CodingAchievement[]
  streakFreezeUses       StreakFreezeUse[]
  focusSessions          FocusSession[]
}

model GitCommit {
  id             String        @id @default(uuid())
  userId         String
  organizationId String?
  sha            String
  message        String
  repoName       String
  branch         String?
  additions      Int           @default(0)
  deletions      Int           @default(0)
  committedAt    DateTime
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([userId, sha])
  @@index([userId, committedAt])
}

model CodingAchievement {
  id         String   @id @default(uuid())
  userId     String
  type       String
  unlockedAt DateTime @default(now())
  metadata   Json?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StreakFreezeUse {
  id          String   @id @default(uuid())
  userId      String
  coveredDate String
  usedAt      DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, coveredDate])
}

model FocusSession {
  id       String   @id @default(uuid())
  userId   String
  minutes  Int
  note     String?
  loggedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model Membership {
  id             String       @id @default(uuid())
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())
  userId         String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Project {
  id             String          @id @default(uuid())
  name           String
  description    String?
  createdAt      DateTime        @default(now())
  organizationId String
  decisions      DecisionLog[]
  issues         Issue[]
  meetings       Meeting[]
  pullRequests   PullRequest[]
  deployments    Deployment[]
  buildPipelines BuildPipeline[]
  buildRuns      BuildRun[]
  sprints        Sprint[]
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Issue {
  id               String                   @id @default(uuid())
  title            String
  description      String?
  status           IssueStatus              @default(TODO)
  priority         IssuePriority            @default(MEDIUM)
  dueDate          DateTime?
  estimatePoints   Int?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  organizationId   String
  projectId        String
  creatorId        String
  assigneeId       String?
  // Additive, optional link into the Sprint feature (see Sprint model
  // below). Nullable and onDelete: SetNull so an issue never disappears
  // or fails to save if its sprint is later deleted — it just falls back
  // to the project's unsprinted backlog.
  sprintId         String?
  activityLogs     ActivityLog[]
  comments         Comment[]
  decisionLinks    DecisionRelatedIssue[]
  notifications    Notification[]
  recentlyViewedBy RecentlyViewedIssue[]
  meetingLinks     MeetingLinkedIssue[]
  pullRequestLinks PullRequestLinkedIssue[]
  assignee         User?                    @relation("IssueAssignee", fields: [assigneeId], references: [id])
  creator          User                     @relation("IssueCreator", fields: [creatorId], references: [id])
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint           Sprint?                  @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([projectId])
  @@index([assigneeId])
  @@index([assigneeId, dueDate])
  @@index([sprintId])
}

model Comment {
  id            String       @id @default(uuid())
  body          String
  createdAt     DateTime     @default(now())
  // Exactly one of issueId/pullRequestId is set — Comment is shared
  // between Issues and PullRequests (a PR review discussion is the same
  // shape as an issue discussion) rather than duplicating the model.
  // issueId is still required (not newly optional) so every pre-existing
  // Issue comment and query keeps working untouched; pullRequestId is the
  // new, additive half of the pair.
  issueId       String?
  pullRequestId String?
  authorId      String
  updatedAt     DateTime     @updatedAt
  author        User         @relation(fields: [authorId], references: [id])
  issue         Issue?       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  pullRequest   PullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([pullRequestId])
}

model ActivityLog {
  id             String       @id @default(uuid())
  action         String
  metadata       Json?
  createdAt      DateTime     @default(now())
  organizationId String
  userId         String
  issueId        String?
  decisionId     String?
  decision       DecisionLog? @relation(fields: [decisionId], references: [id])
  issue          Issue?       @relation(fields: [issueId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([issueId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invitation {
  id             String           @id @default(uuid())
  email          String
  role           Role             @default(MEMBER)
  status         InvitationStatus @default(PENDING)
  token          String           @unique
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  organizationId String
  invitedById    String
  invitedBy      User             @relation("InvitationsSent", fields: [invitedById], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model DecisionLog {
  id               String                 @id @default(uuid())
  title            String
  problemStatement String
  context          String
  alternatives     String
  chosenSolution   String
  tradeoffs        String
  consequences     String?
  status           DecisionStatus         @default(DRAFT)
  reviewDate       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  organizationId   String
  authorId         String
  projectId        String?
  activityLogs     ActivityLog[]
  author           User                   @relation(fields: [authorId], references: [id])
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project?               @relation(fields: [projectId], references: [id])
  relatedIssues    DecisionRelatedIssue[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
}

model DecisionRelatedIssue {
  id         String      @id @default(uuid())
  decisionId String
  issueId    String
  decision   DecisionLog @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  issue      Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([decisionId, issueId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Mirrors PasswordResetToken's shape/reasoning exactly: a random opaque
// token is emailed, only its SHA-256 hash is ever persisted, single-use
// (usedAt) and time-boxed (expiresAt). Used to prove the signup email is
// a real, reachable mailbox the account owner actually controls, since
// format validation alone (z.string().email()) accepts syntactically
// valid addresses that don't exist or aren't the user's.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Backs the dashboard's "Notifications" section. Distinct from ActivityLog
// on purpose: ActivityLog records who performed an action (the actor) for
// audit purposes, while a Notification records who should be informed about
// it (the recipient) — often a different person, sometimes several. Deriving
// "my notifications" from ActivityLog.userId would show people their own
// actions, which is not what a notification feed is for.
model Notification {
  id             String           @id @default(uuid())
  type           NotificationType
  message        String
  read           Boolean          @default(false)
  createdAt      DateTime         @default(now())
  recipientId    String
  actorId        String?
  organizationId String
  issueId        String?
  pullRequestId  String?
  deploymentId   String?
  buildRunId     String?
  recipient      User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor          User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  issue          Issue?           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  pullRequest    PullRequest?     @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  deployment     Deployment?      @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  buildRun       BuildRun?        @relation(fields: [buildRunId], references: [id], onDelete: Cascade)

  // Recipient's own feed, newest first — the dashboard's actual read pattern.
  @@index([recipientId, createdAt])
  @@index([organizationId])
}

model NotificationPreference {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  inApp     Boolean          @default(true)
  email     Boolean          @default(false)
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}


// Backs the dashboard's "Recently Viewed Issues" section. One row per
// (user, issue) pair — re-viewing an issue updates viewedAt rather than
// inserting a duplicate row, so "last 10" is a simple, cheap query instead
// of needing de-duplication logic at read time.
model RecentlyViewedIssue {
  id       String   @id @default(uuid())
  userId   String
  issueId  String
  viewedAt DateTime @default(now()) @updatedAt
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue    Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([userId, issueId])
  @@index([userId, viewedAt])
}

enum NotificationType {
  MENTION
  COMMENT
  ASSIGNMENT
  STATUS_CHANGE
  ORG_EVENT
  // Pull Request events — mirrors why Meeting-related events didn't reuse
  // ORG_EVENT for everything: "you were requested as a reviewer" and "your
  // PR was merged" are distinct, actionable notification kinds the
  // frontend can render with dedicated icons (PR_REVIEW_REQUESTED maps to
  // NotificationKind "MENTIONED", PR_MERGED maps 1:1 to the frontend's
  // existing "PR_MERGED" kind — see dashboard.repository.ts's KIND_MAP).
  PR_REVIEW_REQUESTED
  PR_REVIEW_SUBMITTED
  PR_MERGED
  // Deployment events. Two distinct values (not one generic
  // DEPLOYMENT_EVENT) so a failed prod deploy can eventually get its own
  // icon/urgency treatment even though today both map to the frontend's
  // single "DEPLOYMENT_COMPLETED" NotificationKind (see dashboard.dto.ts's
  // comment on that mapping compromise for PR-era precedent).
  DEPLOYMENT_SUCCEEDED
  DEPLOYMENT_FAILED
  BUILD_FAILED
  BUILD_FIXED
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum IssueStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum DecisionStatus {
  DRAFT
  ACCEPTED
  SUPERSEDED
  ARCHIVED
}

// ---------------------------------------------------------------------
// Meetings — "Today's Meetings" backend. Previously the dashboard's
// CalendarProvider interface only had a MockCalendarProvider (always
// returned integrationRequired:true, []), anticipating a future Google/
// Outlook OAuth integration. This adds a first-class, native meeting
// model instead — no external calendar needed. A real calendar provider
// can still be added later as an additional source that merges into the
// same MeetingDto shape; this is not mutually exclusive with that.
// ---------------------------------------------------------------------

enum MeetingKind {
  STANDUP
  SPRINT_PLANNING
  DESIGN_REVIEW
  BACKEND_SYNC
  DEMO
  RETROSPECTIVE
  ONE_ON_ONE
  INCIDENT_REVIEW
  OTHER
}

enum RsvpStatus {
  INVITED
  ACCEPTED
  DECLINED
  TENTATIVE
}

// Deliberately NOT a full RRULE implementation — this generates a fixed,
// finite set of concrete Meeting rows up front (see
// lib/meetingRecurrence.ts), each with its own id and its own
// attendee/RSVP/notes state. That trade-off keeps every other part of the
// system (today's-meetings query, RSVP, notes, issue-linking) working
// against ordinary Meeting rows with zero special-casing for recurrence.
// seriesId is only used to let the UI show/manage "this and future
// occurrences" as a group.
enum RecurrenceRule {
  NONE
  DAILY
  WEEKDAYS
  WEEKLY
}

model Meeting {
  id              String               @id @default(uuid())
  title           String
  kind            MeetingKind          @default(OTHER)
  description     String?
  startsAt        DateTime
  durationMinutes Int                  @default(30)
  location        String? // physical room name, or a video-call URL
  notes           String? // post-meeting minutes, filled in after it happens
  recurrenceRule  RecurrenceRule       @default(NONE)
  seriesId        String? // shared across all instances generated from one recurring create
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  organizationId  String
  projectId       String?
  createdById     String
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy       User                 @relation("MeetingCreator", fields: [createdById], references: [id])
  attendees       MeetingAttendee[]
  linkedIssues    MeetingLinkedIssue[]

  // Powers "today's meetings" (organizationId IN (...), startsAt in [start,end) of today)
  @@index([organizationId, startsAt])
  @@index([projectId])
  @@index([seriesId])
}

// One row per invited user. Distinct from Membership on purpose — who's
// invited to a specific meeting is unrelated to org membership itself,
// and this is where each person's individual RSVP lives.
model MeetingAttendee {
  id          String     @id @default(uuid())
  meetingId   String
  userId      String
  status      RsvpStatus @default(INVITED)
  respondedAt DateTime?
  createdAt   DateTime   @default(now())
  meeting     Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user        User       @relation("MeetingAttendance", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
}

// The "connect a task/issue to a meeting" feature the frontend had no way
// to express before. Many-to-many: one meeting can reference several
// issues (a sprint planning meeting touches many), and one issue can be
// discussed across several meetings (e.g. a recurring incident review).
model MeetingLinkedIssue {
  id        String   @id @default(uuid())
  meetingId String
  issueId   String
  createdAt DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([meetingId, issueId])
  @@index([issueId])
}

// ---------------------------------------------------------------------
// Pull Requests — "Pull Requests Awaiting Review" backend. Previously
// the dashboard's PullRequestProvider interface only had a
// GitHubPullRequestProvider (always returned integrationRequired:true,
// []), anticipating a future GitHub OAuth/App integration. This adds a
// first-class, native pull-request/code-review model instead — same
// move as NativeMeetingCalendarProvider made for meetings. A real
// GitHub/GitLab provider can still be added later as an additional
// source merged into the same PullRequestDto shape; this is not
// mutually exclusive with that (see NativePullRequestProvider.ts).
// ---------------------------------------------------------------------

enum PRStatus {
  OPEN
  MERGED
  CLOSED
}

// Mirrors the frontend's `mergeStatus` union field-for-field (see
// dashboard.dto.ts's PullRequestDto) — kept as a real enum here since,
// unlike urgency (which is derived, not stored — see
// NativePullRequestProvider.ts), mergeability is information the author
// or a CI webhook actually asserts and needs to persist.
enum PRMergeStatus {
  CLEAN
  CONFLICTS
  CHECKS_FAILING
}

enum PRReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  COMMENTED
}

model PullRequest {
  id             String                   @id @default(uuid())
  title          String
  description    String?
  // Free-text, not a real git integration — lets a team track review
  // requests for work hosted anywhere (this repo, a private GitLab, even
  // a design doc) without needing a GitHub App connection at all.
  repoName       String
  sourceBranch   String
  targetBranch   String                   @default("main")
  status         PRStatus                 @default(OPEN)
  mergeStatus    PRMergeStatus            @default(CLEAN)
  filesChanged   Int                      @default(0)
  linesAdded     Int                      @default(0)
  linesRemoved   Int                      @default(0)
  // Optional link out to the real PR if the team also has one on an
  // actual git host — TeamDesk becomes the review-tracking layer on top,
  // not a replacement for the diff view itself.
  externalUrl    String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  mergedAt       DateTime?
  closedAt       DateTime?
  organizationId String
  projectId      String?
  authorId       String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  author         User                     @relation("PullRequestAuthor", fields: [authorId], references: [id])
  reviewers      PullRequestReviewer[]
  linkedIssues   PullRequestLinkedIssue[]
  comments       Comment[]
  notifications  Notification[]
  // A merged PR is often what a deployment actually ships — optional link
  // lets DORA's "lead time for changes" be computed as
  // deployment.deployedAt - pullRequest.mergedAt for whichever PRs are
  // tagged onto a given deploy (see routes/deployments.ts's dora endpoint).
  deployments    Deployment[]
  buildRuns      BuildRun[]

  // Powers "pull requests awaiting review" (organizationId IN (...),
  // status OPEN, joined against reviewers where userId = me).
  @@index([organizationId, status])
  @@index([authorId])
  @@index([projectId])
}

// One row per requested reviewer. Distinct from Membership on purpose —
// same reasoning as MeetingAttendee: who's asked to review a specific PR
// is unrelated to org membership itself, and this is where each
// reviewer's individual approve/request-changes decision lives.
model PullRequestReviewer {
  id            String         @id @default(uuid())
  pullRequestId String
  userId        String
  status        PRReviewStatus @default(PENDING)
  requestedAt   DateTime       @default(now())
  respondedAt   DateTime?
  pullRequest   PullRequest    @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  user          User           @relation("PullRequestReviewerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, userId])
  @@index([userId, status])
}

// The "this PR closes that issue" capability — many-to-many, same shape
// as MeetingLinkedIssue. Merging a PR with linked issues auto-transitions
// each one to DONE (see routes/pullRequests.ts's merge handler) instead
// of leaving that as manual busywork after every merge.
model PullRequestLinkedIssue {
  id            String      @id @default(uuid())
  pullRequestId String
  issueId       String
  createdAt     DateTime    @default(now())
  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  issue         Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, issueId])
  @@index([issueId])
}

// ---------------------------------------------------------------------
// Deployments — "Recent Deployments" backend. Previously the dashboard's
// DeploymentProvider interface only had a MockDeploymentProvider
// (parameterized "vercel"/"render"/etc, always returned
// integrationRequired:true, []), anticipating a future CI/CD webhook
// integration. This adds a first-class, native deployment-tracking model
// instead — same move NativeMeetingCalendarProvider and
// NativePullRequestProvider made for their respective domains. A real
// Vercel/Render/Railway/GitHub-Actions webhook receiver can still be
// layered in later as an additional source that creates rows in this same
// table (or merges into the same DeploymentDto shape); this is not
// mutually exclusive with that — see NativeDeploymentProvider.ts.
//
// Beyond simple tracking, this model also backs three creative additions
// documented in routes/deployments.ts:
//   1. Rollback — `previousDeploymentId` gives every deploy a lineage, so
//      "roll back to the last good deploy" is a real, traceable action
//      (not just a status flip) and the UI can render a rollback chain.
//   2. Synthetic health checks — `healthStatus` lets a deploy be marked
//      healthy/degraded/unhealthy after the fact, independent of whether
//      the deploy itself succeeded (a deploy can succeed and still be
//      unhealthy in production).
//   3. DORA metrics — deployment frequency, lead time for changes (via
//      the optional PullRequest link), change failure rate, and MTTR are
//      all derivable from this table with no extra schema needed.
// ---------------------------------------------------------------------

enum DeployEnvironment {
  PRODUCTION
  PREVIEW
  STAGING
  DEVELOPMENT
}

enum DeployStatus {
  QUEUED
  IN_PROGRESS
  SUCCESS
  FAILED
  ROLLED_BACK
}

// Deliberately separate from DeployStatus: a deploy can SUCCEED and still
// turn UNHEALTHY minutes later once real traffic hits it (that's exactly
// the "change failure rate" signal DORA cares about beyond the initial
// deploy outcome). UNKNOWN is the default until someone runs a check.
enum DeployHealth {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNHEALTHY
}

model Deployment {
  id                   String            @id @default(uuid())
  environment          DeployEnvironment @default(PRODUCTION)
  status               DeployStatus      @default(QUEUED)
  health               DeployHealth      @default(UNKNOWN)
  commitHash           String
  commitMessage        String
  branch               String            @default("main")
  durationSeconds      Int? // set once the deploy leaves IN_PROGRESS
  notes                String? // free-text, e.g. rollback reason or incident note
  createdAt            DateTime          @default(now()) // when the deploy was queued/triggered
  startedAt            DateTime? // QUEUED -> IN_PROGRESS transition time
  completedAt          DateTime? // SUCCESS/FAILED/ROLLED_BACK transition time
  healthCheckedAt      DateTime?
  rolledBackAt         DateTime?
  organizationId       String
  projectId            String?
  pullRequestId        String? // the PR this deploy is believed to ship
  triggeredById        String
  rolledBackById       String?
  // Self-relation: when this deployment IS a rollback, previousDeploymentId
  // points at the deployment it restores the org to. Named `previous`
  // rather than `target` because it always points backward in time.
  previousDeploymentId String?
  previousDeployment   Deployment?       @relation("DeploymentRollbackLineage", fields: [previousDeploymentId], references: [id])
  rollbacks            Deployment[]      @relation("DeploymentRollbackLineage")
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project              Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  pullRequest          PullRequest?      @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
  triggeredBy          User              @relation("DeploymentTriggeredBy", fields: [triggeredById], references: [id])
  rolledBackBy         User?             @relation("DeploymentRolledBackBy", fields: [rolledBackById], references: [id])
  notifications        Notification[]

  // Powers "recent deployments" (organizationId IN (...), ordered by
  // createdAt) and per-environment DORA queries.
  @@index([organizationId, createdAt])
  @@index([organizationId, environment, createdAt])
  @@index([projectId])
  @@index([status])
}

// AI-generated "Today's Focus" dashboard summary, cached per user so we
// don't hit the LLM on every dashboard load. `contextHash` is a hash of
// the inputs that fed the summary (assigned task ids + statuses, unread
// count, pr/deploy counts) — if the hash hasn't changed since the last
// generation, the cached copy is still accurate and we skip the API call
// entirely. TTL is enforced in application code (see AISummaryCacheStore),
// not here, so the freshness window can change without a migration.
model AISummaryCache {
  id          String   @id @default(uuid())
  userId      String
  headline    String
  bullets     Json // string[]
  contextHash String
  model       String // which provider/model produced this (e.g. "claude-sonnet-4-6", "template-fallback")
  generatedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId, generatedAt])
}

// ---------------------------------------------------------------------
// Build Health — same move NativeDeploymentProvider and
// NativePullRequestProvider already made for their domains: replaces the
// permanently-`integrationRequired:true` MockBuildHealthProvider with a
// first-class, native CI/build-tracking layer.
//
// Two models instead of one, because "build health" is really two
// distinct concerns:
//   1. BuildPipeline — the *configuration* of a CI pipeline for a project
//      (which provider, which branch is canonical, and — the important
//      part — a per-pipeline `webhookToken` that lets a *real* GitHub
//      Actions / CircleCI / GitLab CI / Buildkite job POST its actual
//      results here). This is what turns the feature from "another manual
//      log" into a real integration: point your CI config at
//      POST /api/webhooks/ci/:webhookToken and every run shows up.
//   2. BuildRun — one row per pipeline execution, with rich enough detail
//      (per-run coverage, pass/fail counts, flaky test names, a link back
//      to the PR/commit) to power both the dashboard's compact
//      BuildHealthCard *and* a full build-history/trends page, the same
//      way Deployment backs both DeploymentsCard and DORA metrics.
//
// A pipeline can also be driven without any real CI at all — the same
// `simulateOutcome`-style deterministic pipeline routes.ts uses for
// deployments — so the feature is fully demoable with zero external
// setup, and upgrading to a real webhook later requires no schema change.
// ---------------------------------------------------------------------

enum BuildProvider {
  GITHUB_ACTIONS
  CIRCLECI
  GITLAB_CI
  BUILDKITE
  JENKINS
  NATIVE // no external CI — runs deterministically-simulated builds
}

enum BuildRunStatus {
  QUEUED
  RUNNING
  PASSING
  FAILING
  CANCELLED
}

// Per-project CI pipeline configuration. `webhookToken` is the secret
// component of the inbound webhook URL — deliberately not the same as
// any other resource's id, so it can be rotated (see
// routes/buildPipelines.ts's rotate endpoint) without touching the
// pipeline's own id and breaking every BuildRun's foreign key.
model BuildPipeline {
  id             String        @id @default(uuid())
  name           String
  provider       BuildProvider @default(NATIVE)
  defaultBranch  String        @default("main")
  webhookToken   String        @unique @default(uuid())
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String
  projectId      String?
  createdById    String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy      User          @relation(fields: [createdById], references: [id])
  runs           BuildRun[]

  // Powers "list this org's pipelines" and "resolve pipeline from the
  // public webhook URL" (unique webhookToken lookup, no join needed).
  @@index([organizationId])
  @@index([projectId])
}

// One row per CI execution. `buildNumber` is scoped to its pipeline (not
// global) so it reads the way a real CI provider's UI does — "Build #42"
// on *this* pipeline — and is assigned by the server (max+1) rather than
// trusted from an inbound webhook payload, so a replayed/out-of-order
// webhook can't create a duplicate or out-of-sequence number.
model BuildRun {
  id              String         @id @default(uuid())
  buildNumber     Int
  status          BuildRunStatus @default(QUEUED)
  branch          String         @default("main")
  commitHash      String
  commitMessage   String?
  testsPassing    Int            @default(0)
  testsFailing    Int            @default(0)
  testsSkipped    Int            @default(0)
  coveragePercent Float?
  durationSeconds Int?
  // Names of tests that failed on this run but passed on the immediately
  // preceding run for the same pipeline+branch — computed at ingest time
  // (see routes/buildPipelines.ts) so "flaky" is a real signal (failed
  // intermittently) rather than "failed once."
  flakyTestNames  String[]       @default([])
  failureSummary  String?
  logsUrl         String?
  source          String         @default("native") // "native" (simulated) or the provider name that sent the webhook
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  organizationId  String
  projectId       String?
  pipelineId      String
  pullRequestId   String?
  // Null when the run was created by an external CI webhook rather than a
  // user in this app clicking "run build" — same optionality reasoning as
  // Deployment.rolledBackById.
  triggeredById   String?
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  pipeline        BuildPipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pullRequest     PullRequest?   @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
  triggeredBy     User?          @relation("BuildRunTriggeredBy", fields: [triggeredById], references: [id])
  notifications   Notification[]

  // Powers "latest build health" (org, newest first) and per-pipeline
  // history / trend charts.
  @@unique([pipelineId, buildNumber])
  @@index([organizationId, createdAt])
  @@index([pipelineId, createdAt])
  @@index([organizationId, branch, createdAt])
  @@index([status])
}

// ---------------------------------------------------------------------
// Sprints — Quick Actions milestone. Turns "Create Sprint" from a
// disabled tile into a real, first-class feature: a lightweight,
// native sprint/iteration layer scoped to a Project, the same way
// BuildPipeline/BuildRun added a native build-health layer instead of
// staying permanently `integrationRequired: true`.
//
// Deliberately minimal — one model, one enum, one optional FK on Issue —
// because the goal here is "make the Quick Actions tile real and
// useful," not "build a full agile-planning suite." Story points already
// exist on Issue (estimatePoints), so sprint velocity/progress can be
// computed from existing data without adding anything new to Issue
// besides the sprintId link itself.
// ---------------------------------------------------------------------

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model Sprint {
  id             String       @id @default(uuid())
  name           String
  goal           String?
  status         SprintStatus @default(PLANNED)
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  projectId      String
  createdById    String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User         @relation(fields: [createdById], references: [id])
  issues         Issue[]

  // Powers "list this project's sprints" (newest first) and the
  // org-wide "active sprints" quick-actions/dashboard queries.
  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  @@index([status])
}
