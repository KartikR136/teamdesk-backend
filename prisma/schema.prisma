generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  createdAt     DateTime       @default(now())
  activityLogs  ActivityLog[]
  decisions     DecisionLog[]
  invitations   Invitation[]
  issues        Issue[]
  memberships   Membership[]
  projects      Project[]
  notifications Notification[]
  meetings      Meeting[]
  pullRequests  PullRequest[]
}

model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  passwordHash          String
  name                  String
  createdAt             DateTime              @default(now())
  activityLogs          ActivityLog[]
  comments              Comment[]
  decisions             DecisionLog[]
  sentInvitations       Invitation[]          @relation("InvitationsSent")
  assignedIssues        Issue[]               @relation("IssueAssignee")
  createdIssues         Issue[]               @relation("IssueCreator")
  memberships           Membership[]
  passwordResetTokens   PasswordResetToken[]
  refreshTokens         RefreshToken[]
  notificationsReceived Notification[]        @relation("NotificationRecipient")
  notificationsCaused   Notification[]        @relation("NotificationActor")
  recentlyViewedIssues  RecentlyViewedIssue[]
  createdMeetings       Meeting[]             @relation("MeetingCreator")
  meetingAttendances    MeetingAttendee[]     @relation("MeetingAttendance")
  authoredPullRequests  PullRequest[]         @relation("PullRequestAuthor")
  prReviews             PullRequestReviewer[] @relation("PullRequestReviewerUser")
}

model Membership {
  id             String       @id @default(uuid())
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())
  userId         String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Project {
  id             String        @id @default(uuid())
  name           String
  description    String?
  createdAt      DateTime      @default(now())
  organizationId String
  decisions      DecisionLog[]
  issues         Issue[]
  meetings       Meeting[]
  pullRequests   PullRequest[]
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Issue {
  id               String                 @id @default(uuid())
  title            String
  description      String?
  status           IssueStatus            @default(TODO)
  priority         IssuePriority          @default(MEDIUM)
  dueDate          DateTime?
  estimatePoints   Int?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  organizationId   String
  projectId        String
  creatorId        String
  assigneeId       String?
  activityLogs     ActivityLog[]
  comments         Comment[]
  decisionLinks    DecisionRelatedIssue[]
  notifications    Notification[]
  recentlyViewedBy RecentlyViewedIssue[]
  meetingLinks     MeetingLinkedIssue[]
  pullRequestLinks PullRequestLinkedIssue[]
  assignee         User?                  @relation("IssueAssignee", fields: [assigneeId], references: [id])
  creator          User                   @relation("IssueCreator", fields: [creatorId], references: [id])
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([projectId])
  @@index([assigneeId])
  @@index([assigneeId, dueDate])
}

model Comment {
  id            String       @id @default(uuid())
  body          String
  createdAt     DateTime     @default(now())
  // Exactly one of issueId/pullRequestId is set — Comment is shared
  // between Issues and PullRequests (a PR review discussion is the same
  // shape as an issue discussion) rather than duplicating the model.
  // issueId is still required (not newly optional) so every pre-existing
  // Issue comment and query keeps working untouched; pullRequestId is the
  // new, additive half of the pair.
  issueId       String?
  pullRequestId String?
  authorId      String
  updatedAt     DateTime     @updatedAt
  author        User         @relation(fields: [authorId], references: [id])
  issue         Issue?       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  pullRequest   PullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([pullRequestId])
}

model ActivityLog {
  id             String       @id @default(uuid())
  action         String
  metadata       Json?
  createdAt      DateTime     @default(now())
  organizationId String
  userId         String
  issueId        String?
  decisionId     String?
  decision       DecisionLog? @relation(fields: [decisionId], references: [id])
  issue          Issue?       @relation(fields: [issueId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([issueId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invitation {
  id             String           @id @default(uuid())
  email          String
  role           Role             @default(MEMBER)
  status         InvitationStatus @default(PENDING)
  token          String           @unique
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  organizationId String
  invitedById    String
  invitedBy      User             @relation("InvitationsSent", fields: [invitedById], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model DecisionLog {
  id               String                 @id @default(uuid())
  title            String
  problemStatement String
  context          String
  alternatives     String
  chosenSolution   String
  tradeoffs        String
  consequences     String?
  status           DecisionStatus         @default(DRAFT)
  reviewDate       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  organizationId   String
  authorId         String
  projectId        String?
  activityLogs     ActivityLog[]
  author           User                   @relation(fields: [authorId], references: [id])
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project?               @relation(fields: [projectId], references: [id])
  relatedIssues    DecisionRelatedIssue[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
}

model DecisionRelatedIssue {
  id         String      @id @default(uuid())
  decisionId String
  issueId    String
  decision   DecisionLog @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  issue      Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([decisionId, issueId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Backs the dashboard's "Notifications" section. Distinct from ActivityLog
// on purpose: ActivityLog records who performed an action (the actor) for
// audit purposes, while a Notification records who should be informed about
// it (the recipient) — often a different person, sometimes several. Deriving
// "my notifications" from ActivityLog.userId would show people their own
// actions, which is not what a notification feed is for.
model Notification {
  id             String           @id @default(uuid())
  type           NotificationType
  message        String
  read           Boolean          @default(false)
  createdAt      DateTime         @default(now())
  recipientId    String
  actorId        String?
  organizationId String
  issueId        String?
  pullRequestId  String?
  recipient      User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor          User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  issue          Issue?           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  pullRequest    PullRequest?     @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  // Recipient's own feed, newest first — the dashboard's actual read pattern.
  @@index([recipientId, createdAt])
  @@index([organizationId])
}

// Backs the dashboard's "Recently Viewed Issues" section. One row per
// (user, issue) pair — re-viewing an issue updates viewedAt rather than
// inserting a duplicate row, so "last 10" is a simple, cheap query instead
// of needing de-duplication logic at read time.
model RecentlyViewedIssue {
  id       String   @id @default(uuid())
  userId   String
  issueId  String
  viewedAt DateTime @default(now()) @updatedAt
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue    Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([userId, issueId])
  @@index([userId, viewedAt])
}

enum NotificationType {
  MENTION
  COMMENT
  ASSIGNMENT
  STATUS_CHANGE
  ORG_EVENT
  // Pull Request events — mirrors why Meeting-related events didn't reuse
  // ORG_EVENT for everything: "you were requested as a reviewer" and "your
  // PR was merged" are distinct, actionable notification kinds the
  // frontend can render with dedicated icons (PR_REVIEW_REQUESTED maps to
  // NotificationKind "MENTIONED", PR_MERGED maps 1:1 to the frontend's
  // existing "PR_MERGED" kind — see dashboard.repository.ts's KIND_MAP).
  PR_REVIEW_REQUESTED
  PR_REVIEW_SUBMITTED
  PR_MERGED
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum IssueStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum DecisionStatus {
  DRAFT
  ACCEPTED
  SUPERSEDED
  ARCHIVED
}

// ---------------------------------------------------------------------
// Meetings — "Today's Meetings" backend. Previously the dashboard's
// CalendarProvider interface only had a MockCalendarProvider (always
// returned integrationRequired:true, []), anticipating a future Google/
// Outlook OAuth integration. This adds a first-class, native meeting
// model instead — no external calendar needed. A real calendar provider
// can still be added later as an additional source that merges into the
// same MeetingDto shape; this is not mutually exclusive with that.
// ---------------------------------------------------------------------

enum MeetingKind {
  STANDUP
  SPRINT_PLANNING
  DESIGN_REVIEW
  BACKEND_SYNC
  DEMO
  RETROSPECTIVE
  ONE_ON_ONE
  INCIDENT_REVIEW
  OTHER
}

enum RsvpStatus {
  INVITED
  ACCEPTED
  DECLINED
  TENTATIVE
}

// Deliberately NOT a full RRULE implementation — this generates a fixed,
// finite set of concrete Meeting rows up front (see
// lib/meetingRecurrence.ts), each with its own id and its own
// attendee/RSVP/notes state. That trade-off keeps every other part of the
// system (today's-meetings query, RSVP, notes, issue-linking) working
// against ordinary Meeting rows with zero special-casing for recurrence.
// seriesId is only used to let the UI show/manage "this and future
// occurrences" as a group.
enum RecurrenceRule {
  NONE
  DAILY
  WEEKDAYS
  WEEKLY
}

model Meeting {
  id              String               @id @default(uuid())
  title           String
  kind            MeetingKind          @default(OTHER)
  description     String?
  startsAt        DateTime
  durationMinutes Int                  @default(30)
  location        String? // physical room name, or a video-call URL
  notes           String? // post-meeting minutes, filled in after it happens
  recurrenceRule  RecurrenceRule       @default(NONE)
  seriesId        String? // shared across all instances generated from one recurring create
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  organizationId  String
  projectId       String?
  createdById     String
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy       User                 @relation("MeetingCreator", fields: [createdById], references: [id])
  attendees       MeetingAttendee[]
  linkedIssues    MeetingLinkedIssue[]

  // Powers "today's meetings" (organizationId IN (...), startsAt in [start,end) of today)
  @@index([organizationId, startsAt])
  @@index([projectId])
  @@index([seriesId])
}

// One row per invited user. Distinct from Membership on purpose — who's
// invited to a specific meeting is unrelated to org membership itself,
// and this is where each person's individual RSVP lives.
model MeetingAttendee {
  id          String     @id @default(uuid())
  meetingId   String
  userId      String
  status      RsvpStatus @default(INVITED)
  respondedAt DateTime?
  createdAt   DateTime   @default(now())
  meeting     Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user        User       @relation("MeetingAttendance", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
}

// The "connect a task/issue to a meeting" feature the frontend had no way
// to express before. Many-to-many: one meeting can reference several
// issues (a sprint planning meeting touches many), and one issue can be
// discussed across several meetings (e.g. a recurring incident review).
model MeetingLinkedIssue {
  id        String   @id @default(uuid())
  meetingId String
  issueId   String
  createdAt DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([meetingId, issueId])
  @@index([issueId])
}

// ---------------------------------------------------------------------
// Pull Requests — "Pull Requests Awaiting Review" backend. Previously
// the dashboard's PullRequestProvider interface only had a
// GitHubPullRequestProvider (always returned integrationRequired:true,
// []), anticipating a future GitHub OAuth/App integration. This adds a
// first-class, native pull-request/code-review model instead — same
// move as NativeMeetingCalendarProvider made for meetings. A real
// GitHub/GitLab provider can still be added later as an additional
// source merged into the same PullRequestDto shape; this is not
// mutually exclusive with that (see NativePullRequestProvider.ts).
// ---------------------------------------------------------------------

enum PRStatus {
  OPEN
  MERGED
  CLOSED
}

// Mirrors the frontend's `mergeStatus` union field-for-field (see
// dashboard.dto.ts's PullRequestDto) — kept as a real enum here since,
// unlike urgency (which is derived, not stored — see
// NativePullRequestProvider.ts), mergeability is information the author
// or a CI webhook actually asserts and needs to persist.
enum PRMergeStatus {
  CLEAN
  CONFLICTS
  CHECKS_FAILING
}

enum PRReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  COMMENTED
}

model PullRequest {
  id              String              @id @default(uuid())
  title           String
  description     String?
  // Free-text, not a real git integration — lets a team track review
  // requests for work hosted anywhere (this repo, a private GitLab, even
  // a design doc) without needing a GitHub App connection at all.
  repoName        String
  sourceBranch    String
  targetBranch    String              @default("main")
  status          PRStatus            @default(OPEN)
  mergeStatus     PRMergeStatus       @default(CLEAN)
  filesChanged    Int                 @default(0)
  linesAdded      Int                 @default(0)
  linesRemoved    Int                 @default(0)
  // Optional link out to the real PR if the team also has one on an
  // actual git host — TeamDesk becomes the review-tracking layer on top,
  // not a replacement for the diff view itself.
  externalUrl     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  mergedAt        DateTime?
  closedAt        DateTime?
  organizationId  String
  projectId       String?
  authorId        String
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  author          User                     @relation("PullRequestAuthor", fields: [authorId], references: [id])
  reviewers       PullRequestReviewer[]
  linkedIssues    PullRequestLinkedIssue[]
  comments        Comment[]
  notifications   Notification[]

  // Powers "pull requests awaiting review" (organizationId IN (...),
  // status OPEN, joined against reviewers where userId = me).
  @@index([organizationId, status])
  @@index([authorId])
  @@index([projectId])
}

// One row per requested reviewer. Distinct from Membership on purpose —
// same reasoning as MeetingAttendee: who's asked to review a specific PR
// is unrelated to org membership itself, and this is where each
// reviewer's individual approve/request-changes decision lives.
model PullRequestReviewer {
  id            String         @id @default(uuid())
  pullRequestId String
  userId        String
  status        PRReviewStatus @default(PENDING)
  requestedAt   DateTime       @default(now())
  respondedAt   DateTime?
  pullRequest   PullRequest    @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  user          User           @relation("PullRequestReviewerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, userId])
  @@index([userId, status])
}

// The "this PR closes that issue" capability — many-to-many, same shape
// as MeetingLinkedIssue. Merging a PR with linked issues auto-transitions
// each one to DONE (see routes/pullRequests.ts's merge handler) instead
// of leaving that as manual busywork after every merge.
model PullRequestLinkedIssue {
  id            String      @id @default(uuid())
  pullRequestId String
  issueId       String
  createdAt     DateTime    @default(now())
  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  issue         Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, issueId])
  @@index([issueId])
}
